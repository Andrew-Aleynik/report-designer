<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.andrewaleynik.reportdesigner.reportdesigner.controllers.MainController">

    <top>
        <MenuBar>
            <Menu text="Файл">
                <MenuItem text="Выход" onAction="#handleExit"/>
            </Menu>
            <Menu text="Справка">
                <MenuItem text="Инструкция" onAction="#handleInstructions"/>
            </Menu>
        </MenuBar>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Структурная модель объекта">
                <fx:include source="ElementsTreeTab.fxml"/>
            </Tab>
            <Tab text="Потребительские качества">
                <fx:include source="QualitiesTab.fxml"/>
            </Tab>
            <Tab text="Внешние воздействия">
                <fx:include source="ExternalInfluenceTab.fxml"/>
            </Tab>
            <Tab text="Интенсивности внешних воздействий">
                <fx:include source="ExternalInfluenceLevelsTab.fxml"/>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
